# Copiar para directus.secret.env (ou deixar o k8s/kind/up.sh gerar valores aleatórios).
# Assina os tokens de acesso.
SECRET=
# Primeiro admin, criado no bootstrap (só na primeira arranque).
ADMIN_PASSWORD=
ADMIN_TOKEN=
# Token estático do utilizador "probe", sem role: só serve para o /server/health.
PROBE_TOKEN=
